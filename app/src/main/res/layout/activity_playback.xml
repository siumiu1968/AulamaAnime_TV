<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/playback_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/playback_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/player_header_scrim"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:layout_gravity="top"
        android:alpha="0"
        android:background="@drawable/player_header_scrim"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/player_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|top"
        android:layout_marginStart="48dp"
        android:layout_marginTop="34dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/player_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/resource_han_rounded_hk_heavy"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:maxWidth="720dp"
            android:shadowColor="#99000000"
            android:shadowDy="1"
            android:shadowRadius="6"
            android:textColor="#FFFFFFFF"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/player_header_episode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/anthropic_sans_variable"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="#99000000"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:textColor="#D9E3ECF5"
            android:textSize="16sp" />
    </LinearLayout>

    <com.jing.sakura.player.SpeedBoostOverlay
        android:id="@+id/player_speed_boost"
        android:layout_width="104dp"
        android:layout_height="40dp"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="48dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/player_skip_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="130dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp"
        android:visibility="gone">

        <com.jing.sakura.player.CountdownActionButton
            android:id="@+id/player_skip_segment"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:clickable="true"
            android:focusable="false"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="128dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:textColor="@android:color/white"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/player_continue_outro"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/player_skip_action"
            android:clickable="true"
            android:focusable="false"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="116dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="@string/player_continue_outro"
            android:textColor="@color/player_skip_text"
            android:textSize="17sp"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/player_season_finale"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="16dp"
        android:visibility="gone" />
</FrameLayout>
