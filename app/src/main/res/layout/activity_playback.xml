<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/playback_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/playback_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/player_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|top"
        android:layout_marginStart="48dp"
        android:layout_marginTop="34dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/player_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/anthropic_sans_variable"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:maxWidth="720dp"
            android:textColor="#FFFFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/player_header_episode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/anthropic_sans_variable"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#C7D1DCEA"
            android:textSize="16sp" />
    </LinearLayout>

    <com.jing.sakura.player.SpeedBoostOverlay
        android:id="@+id/player_speed_boost"
        android:layout_width="124dp"
        android:layout_height="44dp"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="88dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/player_skip_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="130dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp"
        android:visibility="gone">

        <com.jing.sakura.player.CountdownActionButton
            android:id="@+id/player_skip_segment"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:clickable="true"
            android:focusable="false"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="112dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/player_continue_outro"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/player_skip_action"
            android:clickable="true"
            android:focusable="false"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="104dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/player_continue_outro"
            android:textColor="@color/player_skip_text"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
